# OpenRouter API key. In production this is mounted from a secret store
# (never stored in the repo or the container image).
OPENROUTER_API_KEY=your-openrouter-api-key

# OpenRouter model router. Meant to be configurable without a code deploy.
OPENROUTER_MODEL=openrouter/free

# Public application URL used by OpenRouter request headers.
APP_URL=http://localhost:5173

# HTTP port the server listens on. Render injects this automatically.
PORT=8080

# Comma-separated list of origins allowed by CORS (the deployed app is
# same-origin, so this only matters for local cross-origin development).
ALLOWED_ORIGINS=http://localhost:5173

# GCP project that hosts Firestore. Resolved automatically on Render.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# pino log level: debug | info | warn | error
LOG_LEVEL=info

# Set to "false" to disable the crowd-telemetry simulator loop.
TELEMETRY_SIM_ENABLED=true
